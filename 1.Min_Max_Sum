def miniMaxSum(arr):
    min_val = float("inf")
    max_val = float("-inf")
    sum_val = 0
    for i in range(len(arr)):
        min_val = min(min_val,arr[i])
        max_val = max(max_val,arr[i])
        sum_val += arr[i]
        
    min_sum = sum_val - max_val
    max_sum = sum_val - min_val
    
    print(min_sum,max_sum)
    
miniMaxSum(arr)
